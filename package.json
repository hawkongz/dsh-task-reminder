{
  "name": "dsh-task-reminder",
  "version": "1.2.1",
  "description": "Conversation task-completion reminder for the DSH Web UI: an always-on bottom-right popup card with a live size preview in settings, a synthesized chime with four selectable effects that play instantly on switch, and an on-by-default system notification — all in a dedicated Settings → Task reminder page with one-click restore defaults.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "web-ui",
    "notification",
    "reminder"
  ],
  "license": "MIT",
  "author": "hawkongz",
  "homepage": "https://github.com/hawkongz/dsh-task-reminder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hawkongz/dsh-task-reminder.git"
  },
  "bugs": {
    "url": "https://github.com/hawkongz/dsh-task-reminder/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "test"
  ],
  "scripts": {
    "test": "node test/verify-client.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/cordis": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
